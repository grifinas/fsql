{
    "compilerOptions": {
      "isolatedModules": true,
      "target": "ES2020",
      "module": "Node16",
      "strict": true,
      "esModuleInterop": true,
      "moduleResolution": "node16",
      "resolveJsonModule": true,
      "outDir": "dist",
      "rootDir": "./",
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "sourceMap": true,
      "baseUrl": "./src",
      "paths": {
        "@data": ["data/index"],
        "@entities": ["entities/index"],
        "@lexer": ["lexer/index"],
        "@sqlFunctions": ["sqlFunctions/index"],
        "@tokenizer": ["tokenizer/index"],
        "@utils": ["utils/index"],
        "@src/*": ["./*"],
        "@types": ["types"]
      }
    },
    "include": ["src", "jestSetup.ts", "test"],
    "exclude": ["node_modules", "dist"]
  }