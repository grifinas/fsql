{
  "name": "fsql",
  "version": "0.3.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "./dist/index.mjs",
  "types": "./dist/plugins.d.ts",
  "directories": {
    "test": "test"
  },
  "bin": {
    "fsql": "./dist/cli.mjs"
  },
  "scripts": {
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release:major": "standard-version --release-as major",
    "publish": "./scripts/release.sh",
    "publish:patch": "./scripts/release.sh patch",
    "publish:minor": "./scripts/release.sh minor",
    "publish:major": "./scripts/release.sh major",
    "cli": "node ./dist/cli.mjs --repl",
    "test": "jest --verbose --noStackTrace --silent=false",
    "test:clean": "jest --verbose --noStackTrace --silent=false --noErrorDetails",
    "test:minimal": "jest --reporters=./minimalReporter.js --silent",
    "confirm": "npm run build && npm run lint && npm run test",
    "build": "node esbuild.config.js && chmod +x ./dist/cli.mjs && npm run build:declarations",
    "build:declarations": "cp ./src/plugins/types.d.ts ./dist/plugins.d.ts",
    "build:tsc": "tsc",
    "run": "node ./dist/index.mjs",
    "cc": "npm run build && npm run cli",
    "lint": "npm run build:tsc && npm run prettier && npm run lint:fix",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prettier": "prettier --write src/**/*.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.25.8",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.0.0",
    "globals": "^15.0.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "4.0.0",
    "prettier": "^3.5.3",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "chalk": "^4.0.0",
    "yargs": "^17.7.2",
    "zod": "^4.0.5"
  }
}
